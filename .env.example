# Runtime environment for the worker container (set these in Coolify).

# --- Keycloak connection -----------------------------------------------------
# Base URL, no trailing slash. Legacy Keycloak (<17) needs the /auth suffix.
KEYCLOAK_URL=https://auth.example.com
# The realm whose users get swept.
KEYCLOAK_REALM=wemsapp
# Realm that issues the service-account token. Defaults to KEYCLOAK_REALM;
# only set this if the client lives in a different realm (e.g. master).
#KEYCLOAK_TOKEN_REALM=

# --- Service account credentials --------------------------------------------
# Confidential client with Service Accounts enabled, holding the
# realm-management roles: view-users and manage-users.
KEYCLOAK_CLIENT_ID=passwordless-mover-upper
KEYCLOAK_CLIENT_SECRET=

# --- Behaviour ---------------------------------------------------------------
# The "X" from the brief: minutes between sweeps, measured start-to-start.
INTERVAL_MINUTES=15
# Credential type to promote. Change only if you mean webauthn (2FA) instead.
CREDENTIAL_TYPE=webauthn-passwordless
# Log what would move, without calling moveToFirst. Great for the first run.
DRY_RUN=false
# Run a single sweep and exit — use this if you'd rather drive it from cron.
RUN_ONCE=false

# --- Tuning (optional) -------------------------------------------------------
#PAGE_SIZE=100
#REQUEST_TIMEOUT=30
#MAX_RETRIES=3
#RETRY_BACKOFF=2
#VERIFY_TLS=true
#LOG_LEVEL=INFO
#INTERVAL_SECONDS=          # overrides INTERVAL_MINUTES; for testing
